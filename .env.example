# ALTURA 72 - Variables de Entorno (Configuración de Producción / Supabase)
# Copia este archivo como .env para activar Supabase opcionalmente.
# Si no se definen, el proyecto opera automáticamente con persistencia en localStorage.

# Supabase URL (Panel de Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (Segura para clientes de Vite)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Contraseña de acceso para el Panel Administrativo (/admin)
# Contraseña por defecto para pruebas demo: admin72
VITE_ADMIN_PASS=admin72
